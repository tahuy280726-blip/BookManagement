@model Book

<h1>Thêm sách</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <div class="field">
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="validation"></span>
    </div>

    <div class="field">
        <label asp-for="Author"></label>
        <input asp-for="Author" />
        <span asp-validation-for="Author" class="validation"></span>
    </div>

    <div class="field">
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" />
        <span asp-validation-for="Price" class="validation"></span>
    </div>

    <button class="btn" type="submit">Lưu sách</button>
    <a asp-action="Index">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
