@model Book

<h1>Thêm sách</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="validation"></div>

    <div class="field">
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="validation"></span>
    </div>

    <div class="field">
        <label asp-for="Author"></label>
        <input asp-for="Author" />
        <span asp-validation-for="Author" class="validation"></span>
    </div>

    <div class="field">
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" />
        <span asp-validation-for="Price" class="validation"></span>
    </div>

    <div class="field">
        <label for="images">Hình ảnh sách (có thể chọn 1 hoặc nhiều ảnh)</label>
        <input id="images" name="images" type="file" accept=".jpg,.png" multiple />
        <small>Chỉ chấp nhận JPG hoặc PNG, có thể chọn một hoặc nhiều ảnh.</small>
    </div>

    <button class="btn" type="submit">Lưu sách</button>
    <a asp-action="Index">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
