<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book Management - Middleware</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background: #f4f6f8; color: #222; }
        nav { background: #1f2937; padding: 15px 30px; }
        nav a { color: white; text-decoration: none; margin-right: 20px; font-weight: bold; }
        .container { max-width: 1000px; margin: 30px auto; background: white; padding: 30px; border-radius: 10px; box-shadow: 0 2px 10px #ddd; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        th { background: #e9eef5; }
        .btn { display: inline-block; padding: 9px 14px; background: #2563eb; color: white; text-decoration: none; border: 0; border-radius: 5px; cursor: pointer; }
        .btn:hover { background: #1d4ed8; }
        .field { margin-bottom: 15px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; }
        input { width: 100%; box-sizing: border-box; padding: 10px; border: 1px solid #ccc; border-radius: 5px; }
        .validation { color: #dc2626; }
        footer { text-align: center; color: #666; padding: 20px; }
    </style>
</head>
<body>
    <nav>
        <a asp-controller="Book" asp-action="Index">Book Management</a>
        <a asp-controller="Book" asp-action="Create">Thêm sách</a>
    </nav>
    <main class="container">
        @RenderBody()
    </main>
    <footer>ASP.NET Core MVC - .NET 10 - Middleware Assignment</footer>
</body>
</html>
